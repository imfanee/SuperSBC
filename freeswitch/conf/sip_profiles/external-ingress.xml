<!--
  external-ingress: the customer-facing profile. Customers are identified by
  source IP (no registration, no digest auth). Every INVITE runs the Lua
  pipeline in the "public" dialplan context.
-->
<profile name="external-ingress">
  <aliases/>
  <gateways/>
  <domains>
    <domain name="all" alias="false" parse="false"/>
  </domains>
  <settings>
    <param name="debug" value="0"/>
    <param name="sip-trace" value="no"/>
    <param name="sip-capture" value="no"/>
    <param name="user-agent-string" value="$${sbc_user_agent}"/>
    <param name="context" value="public"/>
    <param name="dialplan" value="XML"/>
    <param name="sip-port" value="$${sbc_ingress_port}"/>
    <param name="sip-ip" value="$${sbc_sip_ip}"/>
    <param name="rtp-ip" value="$${sbc_rtp_ip}"/>
    <param name="ext-sip-ip" value="$${sbc_ext_ip}"/>
    <param name="ext-rtp-ip" value="$${sbc_ext_ip}"/>
    <param name="rfc2833-pt" value="101"/>
    <param name="dtmf-duration" value="2000"/>
    <param name="dtmf-type" value="rfc2833"/>
    <param name="inbound-codec-prefs" value="$${sbc_ingress_codecs}"/>
    <param name="outbound-codec-prefs" value="$${sbc_ingress_codecs}"/>
    <param name="inbound-codec-negotiation" value="generous"/>
    <param name="disable-transcoding" value="false"/>
    <param name="hold-music" value="silence"/>
    <!-- Trunk mode: no registrations, no digest auth, admission by ACL then dialplan. -->
    <param name="auth-calls" value="false"/>
    <param name="auth-all-packets" value="false"/>
    <param name="apply-inbound-acl" value="customers"/>
    <param name="disable-register" value="true"/>
    <param name="accept-blind-reg" value="false"/>
    <param name="accept-blind-auth" value="false"/>
    <param name="inbound-reg-force-matching-username" value="false"/>
    <!-- Header hygiene towards customers: never generate P-Asserted-Identity /
         Remote-Party-ID in our responses (Section 7). -->
    <param name="pass-callee-id" value="false"/>
    <param name="cid-in-1xx" value="false"/>
    <!-- Session timers (RFC 4028), D-33 -->
    <param name="enable-timer" value="true"/>
    <param name="session-timeout" value="1800"/>
    <param name="minimum-session-expires" value="120"/>
    <!-- RTP timeouts are per-channel variables in 1.10 (media_timeout,
         media_hold_timeout, milliseconds); sbc-api sets them from
         SBC_MEDIA_TIMEOUT_SEC / SBC_MEDIA_HOLD_TIMEOUT_SEC on both legs. -->
    <param name="rtp-timer-name" value="soft"/>
    <param name="rtp-autoflush-during-bridge" value="true"/>
    <param name="rtp-rewrite-timestamps" value="true"/>
    <param name="inbound-late-negotiation" value="true"/>
    <param name="inbound-zrtp-passthru" value="false"/>
    <param name="nonce-ttl" value="60"/>
    <param name="manage-shared-appearance" value="false"/>
    <!-- 100rel / PRACK (Section 7), toggled per profile from the environment -->
    <param name="enable-100rel" value="$${sbc_ingress_100rel}"/>
    <!-- SIP TLS (Section 7). SRTP is decided per call with rtp_secure_media. -->
    <param name="tls" value="$${sbc_tls}"/>
    <param name="tls-only" value="false"/>
    <param name="tls-bind-params" value="transport=tls"/>
    <param name="tls-sip-port" value="$${sbc_ingress_tls_port}"/>
    <param name="tls-cert-dir" value="/etc/freeswitch/tls"/>
    <param name="tls-version" value="$${sbc_tls_version}"/>
    <param name="tls-verify-policy" value="$${sbc_tls_verify_policy}"/>
    <param name="tls-verify-date" value="true"/>
    <param name="NDLB-force-rport" value="true"/>
    <param name="NDLB-received-in-nat-reg-contact" value="false"/>
    <param name="aggressive-nat-detection" value="false"/>
    <param name="challenge-realm" value="auto_from"/>
    <param name="record-path" value="/tmp"/>
    <param name="local-network-acl" value="localnet.auto"/>
    <param name="max-proceeding" value="1000"/>
    <param name="sip-options-respond-503-on-busy" value="true"/>
    <param name="log-auth-failures" value="true"/>
  </settings>
</profile>
