<include>
  <!-- Values injected from the container environment (see .env.example). -->
  <X-PRE-PROCESS cmd="exec-set" data="sbc_esl_password=echo ${SBC_ESL_PASSWORD:-ClueCon}"/>
  <X-PRE-PROCESS cmd="exec-set" data="sbc_internal_secret=echo ${SBC_INTERNAL_SECRET:-change-me}"/>
  <X-PRE-PROCESS cmd="exec-set" data="sbc_api_base=echo ${SBC_API_INTERNAL_URL:-http://api:8081}"/>
  <X-PRE-PROCESS cmd="exec-set" data="sbc_node_ip=echo ${SBC_FS_NODE_IP:-auto}"/>
  <X-PRE-PROCESS cmd="exec-set" data="sbc_ext_ip=echo ${SBC_FS_EXT_IP:-${SBC_FS_NODE_IP:-auto}}"/>
  <X-PRE-PROCESS cmd="exec-set" data="sbc_esl_listen_ip=echo ${SBC_FS_ESL_LISTEN_IP:-0.0.0.0}"/>
  <!-- On the host network, local ESL clients (fs_cli, healthcheck) connect from the node address. -->
  <X-PRE-PROCESS cmd="exec-set" data="sbc_esl_local_cidr=echo ${SBC_FS_NODE_IP:-127.0.0.1}/32 | sed s#auto/32#127.0.0.1/32#"/>
  <X-PRE-PROCESS cmd="exec-set" data="sbc_ingress_port=echo ${SBC_FS_INGRESS_PORT:-5060}"/>
  <X-PRE-PROCESS cmd="exec-set" data="sbc_egress_port=echo ${SBC_FS_EGRESS_PORT:-5080}"/>
  <X-PRE-PROCESS cmd="exec-set" data="sbc_rtp_start=echo ${SBC_FS_RTP_START:-16384}"/>
  <X-PRE-PROCESS cmd="exec-set" data="sbc_rtp_end=echo ${SBC_FS_RTP_END:-16484}"/>
  <X-PRE-PROCESS cmd="exec-set" data="sbc_max_sessions=echo ${SBC_FS_MAX_SESSIONS:-1000}"/>
  <X-PRE-PROCESS cmd="exec-set" data="sbc_sessions_per_second=echo ${SBC_FS_SESSIONS_PER_SECOND:-100}"/>
  <X-PRE-PROCESS cmd="exec-set" data="sbc_ingress_codecs=echo ${SBC_FS_INGRESS_CODECS:-PCMA,PCMU,OPUS,G722}"/>
  <X-PRE-PROCESS cmd="exec-set" data="sbc_egress_codecs=echo ${SBC_FS_EGRESS_CODECS:-PCMA,PCMU,OPUS,G722}"/>
  <X-PRE-PROCESS cmd="exec-set" data="sbc_user_agent=echo ${SBC_FS_USER_AGENT:-OpenSBC}"/>
  <X-PRE-PROCESS cmd="exec-set" data="sbc_log_level=echo ${SBC_FS_LOG_LEVEL:-info}"/>
  <!-- SIP TLS (Section 7): certificates in /etc/freeswitch/tls (agent.pem = key + certificate, cafile.pem) -->
  <X-PRE-PROCESS cmd="exec-set" data="sbc_tls=echo ${SBC_FS_TLS:-false}"/>
  <X-PRE-PROCESS cmd="exec-set" data="sbc_ingress_tls_port=echo ${SBC_FS_INGRESS_TLS_PORT:-5061}"/>
  <X-PRE-PROCESS cmd="exec-set" data="sbc_egress_tls_port=echo ${SBC_FS_EGRESS_TLS_PORT:-5081}"/>
  <X-PRE-PROCESS cmd="exec-set" data="sbc_tls_verify_policy=echo ${SBC_FS_TLS_VERIFY_POLICY:-none}"/>
  <X-PRE-PROCESS cmd="exec-set" data="sbc_tls_version=echo ${SBC_FS_TLS_VERSION:-tlsv1.2,tlsv1.3}"/>
  <X-PRE-PROCESS cmd="exec-set" data="sbc_ingress_100rel=echo ${SBC_FS_INGRESS_100REL:-false}"/>
  <X-PRE-PROCESS cmd="exec-set" data="sbc_egress_100rel=echo ${SBC_FS_EGRESS_100REL:-false}"/>
  <!-- HEP/HOMER capture (D-65): SBC_FS_HEP_SERVER like "udp:homer:9060;hep=3;capture_id=100" turns sip-capture on -->
  <X-PRE-PROCESS cmd="exec-set" data="sbc_hep_server=echo ${SBC_FS_HEP_SERVER:-udp:127.0.0.1:9060;hep=3;capture_id=0}"/>
  <X-PRE-PROCESS cmd="exec-set" data="sbc_sip_capture=x=${SBC_FS_HEP_SERVER:+yes}; echo ${x:-no}"/>

  <!-- When sbc_node_ip is "auto" FreeSWITCH picks the primary interface.
       sbc_ext_ip is what goes into Contact and SDP (the public address when
       the host sits behind 1:1 NAT); it defaults to the node ip. -->
  <X-PRE-PROCESS cmd="set" data="sbc_sip_ip=$${sbc_node_ip}"/>
  <X-PRE-PROCESS cmd="set" data="sbc_rtp_ip=$${sbc_node_ip}"/>
</include>
