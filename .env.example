# Copy to .env. Every variable is read by docker compose and passed to the services.

# ---- Shared secrets (change in production) ----
SBC_INTERNAL_SECRET=change-me-internal-secret
SBC_ESL_PASSWORD=change-me-esl-password
SBC_JWT_SECRET=change-me-jwt-secret-at-least-32-bytes-long
POSTGRES_PASSWORD=opensbc

# ---- Bootstrap admin (created on first start if no users exist) ----
SBC_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
SBC_BOOTSTRAP_ADMIN_PASSWORD=admin12345

# ---- sbc-api ----
SBC_ENV=dev
SBC_LOG_LEVEL=info
SBC_ADMIN_LISTEN=:8080
SBC_INTERNAL_LISTEN=:8081
SBC_DATABASE_URL=postgres://opensbc:opensbc@postgres:5432/opensbc?sslmode=disable
SBC_AUTO_MIGRATE=true
SBC_REDIS_URL=redis://redis:6379/0
SBC_ESL_HOST=freeswitch
SBC_ESL_PORT=8021
SBC_FS_CONFIG_DIR=/fsconfig
# dialplan: unknown IPs get "403 IP not authorized" from Lua. strict: Sofia drops them silently (cheaper under scan).
SBC_ACL_MODE=dialplan
SBC_AUTH_COOKIE_SECURE=false

# Billing (Section 3 Step 4/5, Section 5)
SBC_BILLING_RESERVE_MINUTES=5
SBC_BILLING_MAX_CALL_DURATION=4h
SBC_BILLING_ORPHAN_TIMEOUT=10m
SBC_BILLING_LOW_BALANCE_THRESHOLD=5.00
SBC_BILLING_CURRENCY=USD

# Routing (Section 3 Step 8)
SBC_ROUTING_ORIGINATE_TIMEOUT=60
SBC_ROUTING_PROGRESS_TIMEOUT=8
SBC_ROUTING_BLOCK_NEGATIVE_MARGIN=false
SBC_ROUTING_GLOBAL_MAX_CPS=0
SBC_ROUTING_GLOBAL_MAX_CHANNELS=0
# RTP timeouts (D-34): hang up a call after this many seconds without media
SBC_MEDIA_TIMEOUT_SEC=300
SBC_MEDIA_HOLD_TIMEOUT_SEC=1800

# Failover (Section 6)
SBC_FAILOVER_RULES_FILE=/app/failover.yaml
SBC_FAILOVER_MIN_RING_SECONDS_FOR_NO_ANSWER=10
SBC_FAILOVER_BREAKER_CONSECUTIVE_FAULTS=20
SBC_FAILOVER_BREAKER_ASR_THRESHOLD_PERCENT=10
SBC_FAILOVER_BREAKER_ASR_MIN_SAMPLES=50
SBC_FAILOVER_BREAKER_DEGRADED_SECONDS=60
SBC_FAILOVER_GATEWAY_PING_INTERVAL_SECONDS=10

# ---- FreeSWITCH ----
# "auto" lets FreeSWITCH pick the primary interface. In the default compose
# network this is 172.28.0.10. With network_mode: host set the public IP.
SBC_FS_NODE_IP=172.28.0.10
SBC_FS_INGRESS_PORT=5060
SBC_FS_EGRESS_PORT=5080
SBC_FS_RTP_START=16384
SBC_FS_RTP_END=32768
SBC_FS_MAX_SESSIONS=1000
SBC_FS_SESSIONS_PER_SECOND=300
SBC_FS_INGRESS_CODECS=PCMA,PCMU,OPUS,G722
SBC_FS_EGRESS_CODECS=PCMA,PCMU,OPUS,G722
SBC_FS_USER_AGENT=OpenSBC
SBC_FS_LOG_LEVEL=info
SBC_API_INTERNAL_URL=http://api:8081

# ---- Web UI ----
# Dev ports are bound to 127.0.0.1 only; the live environment (deploy/live) owns 8080/8443/5060 on the host.
SBC_WEB_PORT=13000
SBC_ADMIN_PORT=18080
SBC_GRAFANA_PORT=13001
SBC_PROMETHEUS_PORT=19090

# ---- Host ports for Postgres and Redis (loopback only; used by make test-integration) ----
SBC_PG_PORT=15432
SBC_REDIS_PORT=16379
