{
 "title": "OpenSBC",
 "uid": "opensbc",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "10s",
 "time": {
  "from": "now-1h",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Calls in progress",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 6,
    "h": 5
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "sbc_calls_in_progress",
     "legendFormat": "live",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   }
  },
  {
   "id": 2,
   "type": "stat",
   "title": "CPS (setups per second)",
   "gridPos": {
    "x": 6,
    "y": 0,
    "w": 6,
    "h": 5
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "sum(rate(sbc_call_setups_total[1m]))",
     "legendFormat": "cps",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   }
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "ASR per carrier (5m)",
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 5
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "sum by (carrier) (rate(sbc_carrier_attempts_total{classification=\"answered\"}[5m])) / sum by (carrier) (rate(sbc_carrier_attempts_total[5m]))",
     "legendFormat": "{{carrier}}{{customer}}{{step}}{{gateway}}{{mode}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   }
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Attempts per carrier by classification",
   "gridPos": {
    "x": 0,
    "y": 5,
    "w": 12,
    "h": 7
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "sum by (carrier, classification) (rate(sbc_carrier_attempts_total[5m]))",
     "legendFormat": "{{carrier}} {{classification}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   }
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Rejections by step",
   "gridPos": {
    "x": 12,
    "y": 5,
    "w": 12,
    "h": 7
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "sum by (step) (rate(sbc_call_rejections_total[5m]))",
     "legendFormat": "{{carrier}}{{customer}}{{step}}{{gateway}}{{mode}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   }
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "ACD per customer (5m)",
   "gridPos": {
    "x": 0,
    "y": 12,
    "w": 12,
    "h": 7
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "sum by (customer) (rate(sbc_billsec_total[5m])) / sum by (customer) (rate(sbc_calls_billed_total{disposition=\"answered\"}[5m]))",
     "legendFormat": "{{carrier}}{{customer}}{{step}}{{gateway}}{{mode}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   }
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "PDD p95 per carrier",
   "gridPos": {
    "x": 12,
    "y": 12,
    "w": 12,
    "h": 7
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.95, sum by (le, carrier) (rate(sbc_pdd_seconds_bucket[5m])))",
     "legendFormat": "{{carrier}}{{customer}}{{step}}{{gateway}}{{mode}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   }
  },
  {
   "id": 8,
   "type": "stat",
   "title": "Gateway state (1 = UP)",
   "gridPos": {
    "x": 0,
    "y": 19,
    "w": 8,
    "h": 6
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "sbc_gateway_up",
     "legendFormat": "{{carrier}}{{customer}}{{step}}{{gateway}}{{mode}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   }
  },
  {
   "id": 9,
   "type": "stat",
   "title": "Degraded carriers",
   "gridPos": {
    "x": 8,
    "y": 19,
    "w": 8,
    "h": 6
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "sbc_carrier_degraded",
     "legendFormat": "{{carrier}}{{customer}}{{step}}{{gateway}}{{mode}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   }
  },
  {
   "id": 10,
   "type": "timeseries",
   "title": "Media mode",
   "gridPos": {
    "x": 16,
    "y": 19,
    "w": 8,
    "h": 6
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "sum by (mode) (rate(sbc_media_mode_total[5m]))",
     "legendFormat": "{{carrier}}{{customer}}{{step}}{{gateway}}{{mode}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   }
  },
  {
   "id": 11,
   "type": "timeseries",
   "title": "Revenue and cost per minute",
   "gridPos": {
    "x": 0,
    "y": 25,
    "w": 12,
    "h": 7
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "sum(rate(sbc_revenue_total[5m])) * 60",
     "legendFormat": "revenue/min",
     "refId": "A"
    },
    {
     "expr": "sum(rate(sbc_cost_total[5m])) * 60",
     "legendFormat": "cost/min",
     "refId": "B"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   }
  },
  {
   "id": 12,
   "type": "timeseries",
   "title": "Lua to API latency p99 by path",
   "gridPos": {
    "x": 12,
    "y": 25,
    "w": 12,
    "h": 7
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.99, sum by (le, path) (rate(sbc_internal_api_duration_seconds_bucket[5m])))",
     "legendFormat": "{{path}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   }
  },
  {
   "id": 13,
   "type": "timeseries",
   "title": "Reservation failures (no funds)",
   "gridPos": {
    "x": 0,
    "y": 32,
    "w": 12,
    "h": 6
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "sum by (customer) (rate(sbc_reservation_failures_total[5m]))",
     "legendFormat": "{{carrier}}{{customer}}{{step}}{{gateway}}{{mode}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   }
  },
  {
   "id": 14,
   "type": "timeseries",
   "title": "Final SIP codes from carriers",
   "gridPos": {
