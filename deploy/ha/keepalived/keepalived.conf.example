# keepalived on an OpenSBC node (D-68). Copy to /etc/keepalived/keepalived.conf
# on both nodes; on the second node set state BACKUP, priority 100 and swap
# the unicast addresses. The VIP is the address customers and carriers use;
# FreeSWITCH binds it on both nodes (net.ipv4.ip_nonlocal_bind=1, see
# deploy/ha/sysctl-ha.conf) and only the MASTER receives the traffic.
global_defs {
    router_id sbc1
    enable_script_security
    script_user root
}

vrrp_script check_sbc {
    script "/usr/local/bin/check_sbc.sh"
    interval 2
    timeout 3
    fall 3
    rise 2
    weight -60
}

vrrp_instance SBC {
    state MASTER
    interface eth0
    virtual_router_id 51
    priority 150
    advert_int 1
    unicast_src_ip 198.51.100.11
    unicast_peer {
        198.51.100.12
    }
    authentication {
        auth_type PASS
        auth_pass change-me
    }
    virtual_ipaddress {
        198.51.100.10/24 dev eth0
    }
    track_script {
        check_sbc
    }
    notify_master "/usr/local/bin/sbc_notify.sh master"
    notify_backup "/usr/local/bin/sbc_notify.sh backup"
    notify_fault  "/usr/local/bin/sbc_notify.sh fault"
}
